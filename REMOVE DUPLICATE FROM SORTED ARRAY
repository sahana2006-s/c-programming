#include <stdio.h>

int removeDuplicates(int* nums, int numsSize) {
    if (numsSize == 0) return 0;
    
    // 'k' is the index of the last placed unique element
    int k = 0; 
    
    for (int i = 1; i < numsSize; i++) {
        // If we find a new unique element
        if (nums[i] != nums[k]) {
            k++;              // Move to the next unique slot
            nums[k] = nums[i]; // Copy the unique value over
        }
    }
    
    // The number of unique elements is the index k + 1
    return k + 1;
}
