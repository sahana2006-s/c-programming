#include <stdbool.h>

// Helper function to check if placing 'ch' at board[row][col] is valid
bool isValid(char** board, int row, int col, char ch) {
    for (int i = 0; i < 9; i++) {
        // Check row
        if (board[row][i] == ch) return false;
        
        // Check column
        if (board[i][col] == ch) return false;
        
        // Check 3x3 sub-box
        int boxRow = 3 * (row / 3) + i / 3;
        int boxCol = 3 * (col / 3) + i % 3;
        if (board[boxRow][boxCol] == ch) return false;
    }
    return true;
}

// Backtracking solver function
bool solve(char** board) {
    for (int i = 0; i < 9; i++) {
        for (int j = 0; j < 9; j++) {
            // Find an empty cell
            if (board[i][j] == '.') {
                // Try digits '1' through '9'
                for (char ch = '1'; ch <= '9'; ch++) {
                    if (isValid(board, i, j, ch)) {
                        board[i][j] = ch; // Tentatively place character
                        
                        if (solve(board)) {
                            return true; // Solution found, propagate up
                        }
                        
                        board[i][j] = '.'; // Backtrack
                    }
                }
                return false; // No valid digit can fit here; trigger backtracking
            }
        }
    }
    return true; // Whole board is filled successfully
}


 

