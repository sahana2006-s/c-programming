#include <stdio.h>

int removeElement(int* nums, int numsSize, int val) {
    // Safety check for empty arrays
    if (numsSize == 0) {
        return 0;
    }
    
    int k = 0; // Pointer for the next valid slot
    
    for (int i = 0; i < numsSize; i++) {
        if (nums[i] != val) {
            nums[k] = nums[i];
            k++;
        }
    }
    
    return k;
}
