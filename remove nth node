#include <stdlib.h>
 * struct ListNode {
 *     int val;
 *     struct ListNode *next;
 * };
struct ListNode* removeNthFromEnd(struct ListNode* head, int n) {
    // Dummy node handles edge cases like removing the head node cleanly
    struct ListNode dummy;
    dummy.val = 0;
    dummy.next = head;
    
    struct ListNode* fast = &dummy;
    struct ListNode* slow = &dummy;
    
    // Move the fast pointer so that there is a gap of 'n' nodes between fast and slow
    for (int i = 0; i <= n; i++) {
        fast = fast->next;
    }
    
    // Move both pointers simultaneously until fast reaches the end
    while (fast != NULL) {
        fast = fast->next;
        slow = slow->next;
    }
    
    // 'slow' is now pointing to the node right before the target node
    struct ListNode* nodeToDelete = slow->next;
    slow->next = slow->next->next;
    
    // Free the memory of the removed node to prevent memory leaks
    free(nodeToDelete);
    
    return dummy.next;
}
