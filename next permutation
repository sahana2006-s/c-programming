#include <stdio.h>

// Helper function to swap two elements
void swap(int* a, int* b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}

// Helper function to reverse an array segment in place
void reverse(int* nums, int start, int end) {
    while (start < end) {
        swap(&nums[start], &nums[end]);
        start++;
        end--;
    }
}

void nextPermutation(int* nums, int numsSize) {
    if (numsSize <= 1) return;

    // Step 1: Find the first decreasing element from the right
    int i = numsSize - 2;
    while (i >= 0 && nums[i] >= nums[i + 1]) {
        i--;
    }

    // If such an element is found, find the element to swap it with
    if (i >= 0) {
        // Step 2: Find the smallest element greater than nums[i] from the right
        int j = numsSize - 1;
        while (nums[j] <= nums[i]) {
            j--;
        }
        // Swap them
        swap(&nums[i], &nums[j]);
    }

    // Step 3: Reverse the sequence after index i to get the next lowest order
    reverse(nums, i + 1, numsSize - 1);
}
